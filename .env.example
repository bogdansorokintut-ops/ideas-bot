# Токен от @BotFather
BOT_TOKEN=123456:ABC...

# ID таблицы — кусок URL между /d/ и /edit
# https://docs.google.com/spreadsheets/d/<GOOGLE_SHEET_ID>/edit
GOOGLE_SHEET_ID=

# Ключ service account: локально — путь к файлу, на хостинге — содержимое файла одной строкой
GOOGLE_CREDENTIALS=credentials.json
GOOGLE_CREDENTIALS_JSON=

# Кто может писать в таблицу: юзернеймы (без @) и/или числовые id, через запятую.
# Пусто = кто угодно, кто найдёт бота.
ALLOWED_USERS=

# --- LLM (необязательно) ---
# Любой OpenAI-совместимый провайдер. Пусто = бот работает только по правилам.
# Дополняет пустые поля карточки (питч, жанр, loop, хук, рефы); явно указанные не трогает.
# Готовые варианты — в README.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Необязательно. Если с хостинга не достучаться до api.telegram.org — прокси для Telegram:
# http://user:pass@host:port или socks5://user:pass@host:port
TELEGRAM_PROXY=
